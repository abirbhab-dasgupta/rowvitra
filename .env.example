# Frontend: copy to .env.local. All credentials must be real for authenticated mode.
DATABASE_URL=postgresql://user:password@host.neon.tech/rowvitra?sslmode=require
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate_a_random_secret_at_least_32_characters
# Google OAuth is optional; configure Google Cloud with callback /api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cloudinary raw authenticated CSV storage (required for authenticated saved datasets)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Internal server-to-server processor API
PROCESSOR_API_URL=http://localhost:8000
PROCESSOR_SERVICE_TOKEN=replace_with_same_long_random_token_as_python_service
# Optional public, stateless demo; leave false in production (prevents open processing endpoint)
ENABLE_PUBLIC_DEMO=false

# NVIDIA AI configuration belongs in services/processor/.env or the processor deployment.
# Root .env.local is not loaded by the Python processor.
